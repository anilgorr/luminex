# Luminex Windows on Apache / LiteSpeed shared hosting (e.g. MilesWeb cPanel).
# The site is a static Next.js export: this file does what Netlify's _redirects and pretty URLs do.

Options -MultiViews -Indexes
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. One canonical address: https://luminexwindow.com (no www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://luminexwindow.com%{REQUEST_URI} [L,R=301]

# 2. Old PHP pages -> new pages (keeps their Google rankings). Trailing "?" drops old query strings.
RewriteRule ^index\.php$ /? [L,R=301,NC]
RewriteRule ^about\.php$ /about? [L,R=301,NC]
RewriteRule ^contact\.php$ /contact? [L,R=301,NC]
RewriteRule ^windows\.php$ /windows? [L,R=301,NC]
RewriteRule ^doors\.php$ /doors? [L,R=301,NC]
RewriteRule ^gallery\.php$ /gallery? [L,R=301,NC]
RewriteRule ^luminex-difference\.php$ /luminex-difference? [L,R=301,NC]
RewriteRule ^renovations\.php$ /renovations? [L,R=301,NC]
RewriteRule ^(request-quote|insert-request)\.php$ /request-quote? [L,R=301,NC]
RewriteRule ^services\.php$ /windows? [L,R=301,NC]
RewriteRule ^blog(-single)?\.php$ /blog? [L,R=301,NC]
RewriteRule ^faqs\.php$ /faq? [L,R=301,NC]
RewriteRule ^portfolio\.php$ /gallery? [L,R=301,NC]
RewriteRule ^service-single\.php$ /renovations? [L,R=301,NC]
RewriteRule ^team-single\.php$ /about? [L,R=301,NC]
# Any other old .php page
RewriteRule ^.+\.php$ /? [L,R=301,NC]
RewriteRule ^preview(/.*)?$ /? [L,R=301,NC]

# 3. No ".html" and no trailing slash in public URLs
RewriteRule ^index\.html$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 4. Clean URLs: /bhutan/thimphu is served from bhutan/thimphu.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Speed (Core Web Vitals): compress text, cache files with hashed names for a year.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
